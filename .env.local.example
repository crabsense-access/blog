# Supabase — obtené estos valores en Project Settings > API dentro de supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para uso en el servidor (Server Actions / Route Handlers). NUNCA
# exponer con prefijo NEXT_PUBLIC_ ni usar en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL pública del sitio (usada para metadata, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Avisos de leads (bloque "¿Qué proyecto tenés en mente hoy?") ---
# Email por SMTP de Google Workspace. SMTP_PASS es una "contraseña de
# aplicación" (myaccount.google.com/apppasswords), NO la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=avisos@crabsense.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Destinatarios separados por coma
LEAD_EMAIL_TO=martin.tonelli@crabsense.com
# Opcional: remitente visible (debe ser SMTP_USER o un alias de esa casilla)
LEAD_EMAIL_FROM=Crabsense Web <avisos@crabsense.com>

# WhatsApp por CallMeBot: "telefono:apikey" separados por coma (cada número
# activa su propia apikey en https://www.callmebot.com/blog/free-api-whatsapp-messages/)
LEAD_WHATSAPP_RECIPIENTS=+5491100000000:1234567
